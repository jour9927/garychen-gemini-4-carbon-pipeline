# Byte-compiled / virtualenvs
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Large reference downloads & local runtime secrets (voice_refs & analysis summaries ARE tracked)
reference_channel/videos/
reference_channel/frames_*/
configs/colab_token.txt
configs/colab_endpoint.json
.env

# Scratch / intermediate temp frames & heavy rendered media (JSON/MD/VTT/Thumbnails ARE tracked)
outputs/*/frames_tmp/
outputs/*/short_frames_tmp/
outputs/*/qa_frames/
outputs/*/*.mp4
outputs/*/*.wav
outputs/*/audio_long/
outputs/*/audio_short/
